{
  "_comment": "Small 2-team league state for engine.trades / docs/js/trade.js parity checks. slots={QB:1,RB:1}, eligibility={QB:{QB},RB:{RB}}, weeks=[1,2,3].",
  "slots": {"QB": 1, "RB": 1},
  "eligibility": {"QB": ["QB"], "RB": ["RB"]},
  "weeks": [1, 2, 3],
  "players": {
    "qbA1": {"position": "QB", "ppw": 18.0, "ros_total": 54.0},
    "rbA1": {"position": "RB", "ppw": 20.0, "ros_total": 60.0},
    "rbA2": {"position": "RB", "ppw": 5.0, "ros_total": 15.0},
    "qbB1": {"position": "QB", "ppw": 10.0, "ros_total": 30.0},
    "rbB1": {"position": "RB", "ppw": 8.0, "ros_total": 24.0},
    "rbB2": {"position": "RB", "ppw": 22.0, "ros_total": 66.0}
  },
  "roster_a": ["qbA1", "rbA1", "rbA2"],
  "roster_b": ["qbB1", "rbB1", "rbB2"],
  "cases": [
    {
      "name": "favors_a_bench_for_starter",
      "gives_a": ["rbA2"],
      "gives_b": ["rbB2"],
      "expected": {"gain_a": 6.0, "gain_b": -42.0, "favors": "a"}
    },
    {
      "name": "favors_b_starter_for_worse_starter",
      "gives_a": ["rbA1"],
      "gives_b": ["rbB1"],
      "expected": {"gain_a": -36.0, "gain_b": 0.0, "favors": "b"}
    },
    {
      "name": "even_bench_swap",
      "gives_a": ["rbA2"],
      "gives_b": ["rbB1"],
      "expected": {"gain_a": 0.0, "gain_b": 0.0, "favors": "even"}
    }
  ],
  "streaming_cases": [
    {
      "_comment": "Same scenario as test_trades.py's test_evaluate_with_streaming_discounts_a_trade_the_wire_could_replace: team A's only kicker is on bye week 2; team B's kicker offer only helps by the edge over what a week-2 wire kicker already provides (8 - 7 = 1), not the full 0 -> 8 swing a plain evaluate() would give.",
      "name": "kicker_bye_discounted_by_wire",
      "slots": {"K": 1},
      "eligibility": {"K": ["K"]},
      "weeks": [1, 2],
      "players": {
        "kA1": {"position": "K", "ros_total": 10.0, "weekly": {"1": 10.0, "2": 0.0}},
        "kB1": {"position": "K", "ros_total": 16.0, "weekly": {"1": 8.0, "2": 8.0}},
        "otherB": {"position": "K", "ros_total": 2.0, "weekly": {"1": 1.0, "2": 1.0}}
      },
      "free_agents": {
        "K": [{"id": "fa_k", "position": "K", "ros_total": 14.0, "weekly": {"1": 7.0, "2": 7.0}}]
      },
      "roster_a": ["kA1"],
      "roster_b": ["kB1", "otherB"],
      "gives_a": [],
      "gives_b": ["kB1"],
      "expected": {"gain_a": 1.0, "gain_b": -14.0, "favors": "a"}
    }
  ]
}
